# 1) MongoDB connection string
#    Local:  mongodb://127.0.0.1:27017/studybuddy
#    Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studybuddy
MONGODB_URI=mongodb://127.0.0.1:27017/studybuddy

# 2) Free Google Gemini API key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
APP_PASSWORD=replace_with_a_long_random_password
